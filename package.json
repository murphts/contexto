{
  "name": "@murphts/contexto",
  "version": "1.0.5",
  "description": "Styleable context menus for Electron, powered by HTML and CSS.",
  "license": "MIT",
  "author": "Murphy",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup index.js --format cjs,esm --dts --external electron --external @murphts/contexto/* --shims"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murphts/contexto.git"
  },
  "keywords": [
    "context",
    "menu"
  ],
  "files": [
    "dist/",
    "fonts/",
    "preload.js",
    "renderer.js",
    "index.html",
    "style.css",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "electron": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^4.5.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bugs": {
    "url": "https://github.com/murphts/contexto/issues"
  },
  "homepage": "https://github.com/murphts/contexto#readme"
}
